<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac App Store build. The MAS sandbox is mandatory and stricter than direct
  distribution: no JIT entitlements are permitted here, and the app must
  declare every capability it uses.

  network.server is what lets the bundled loopback file server bind to
  127.0.0.1. Without it the window opens to a blank page in a sandboxed build.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
