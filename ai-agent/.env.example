# Copy this file to .env and fill in real values. Never commit the real .env.

# Shared secret every agent and the dashboard must send as the X-API-Key header.
AGENT_API_KEY=change-me

# Claude API key, used by the /chat endpoint.
ANTHROPIC_API_KEY=sk-ant-...

# Email (SMTP) — required for /email/send. Gmail: use an app password, not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=app-password-here
SMTP_FROM=you@example.com

# Optional — SMS / voice calls via Twilio. Leave unset to disable these endpoints.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional — Slack/Discord incoming webhook URLs for POST /notify/external.
# Leave unset to disable that endpoint (it returns 501, not a silent no-op).
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Lock CORS down to your real dashboard origin before exposing this server
# publicly. Defaults to "*" (any origin) for local dev.
DASHBOARD_ORIGIN=*

# Optional — where each local agent finds the cloud server.
AGENT_SERVER_URL=http://localhost:8000
