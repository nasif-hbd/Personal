# Copy this file to .env and fill in your keys.
# Never commit the real .env file.

# Required for the AI Coach plan generator.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Enables "Find more videos" in the Atlas.
# Get a key (with the YouTube Data API v3 enabled) at
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
